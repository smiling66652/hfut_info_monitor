# 合工大信息监控系统 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# 此文件已被 git 忽略，不会提交到仓库

# ====== QQ邮箱SMTP配置 ======
SENDER_PASSWORD=你的邮箱授权码

# ====== NapCat QQ机器人配置 ======
NAPCAT_TOKEN=NapCat_API_Token
NAPCAT_BOT_QQ=你的机器人QQ号
NAPCAT_DEFAULT_RECEIVER=默认接收者QQ号

# ====== AI/LLM配置（可选）======
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:7b

# ====== 云端API配置（可选）======
# CLOUD_API_KEY=sk-xxx
# CLOUD_API_BASE=https://api.openai.com/v1
